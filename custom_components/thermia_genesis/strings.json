          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]"
        },
        "data_description": {
          "host": "The IP address or host name of the heat pump.",
          "port": "The Modbus TCP port of the heat pump, usually 502."
        }
      },
      "reconfigure": {
        "description": "Change the address of the heat pump. Its entities and their history are kept.",
