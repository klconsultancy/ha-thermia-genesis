{
  "config": {
    "step": {
      "user": {
        "description": "Connect to the heat pump's Genesis controller over Modbus TCP.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]"
        },
        "data_description": {
          "host": "The IP address or host name of the heat pump.",
          "port": "The Modbus TCP port of the heat pump, usually 502."
        }
      },
      "reconfigure": {
        "description": "Change the address of the heat pump. Its entities and their history are kept.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]"
        },
        "data_description": {
          "host": "[%key:component::thermia_genesis::config::step::user::data_description::host%]",
          "port": "[%key:component::thermia_genesis::config::step::user::data_description::port%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "connection_in_use": "Another integration already uses this address with different connection settings.",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    }
  }
}
